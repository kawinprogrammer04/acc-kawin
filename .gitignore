backend/.venv/

# Node
frontend/node_modules/
frontend/dist/

# Editor
.vscode/
.idea/
*.swp

# DB backups (local only)
*_backup_*.sql
pre-deploy-backup-*.dump

# Generated local exports / scratch files
output/
outputs/
tmp/
