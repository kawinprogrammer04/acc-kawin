# ══════════════════════════════════════════════════════════════════════════════
# Thai SME Accounting System — Environment Variables
# Copy to .env and fill in real values before running docker compose up
# NEVER commit .env to version control
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=accounting_db
POSTGRES_USER=postgres
# Required — must not be left blank
POSTGRES_PASSWORD=change_me_strong_password_here

# Local path for persistent data (created automatically by Makefile)
DATA_DIR=./data

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_char_hex_secret_key_do_not_use_this_value

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480       # 8 hours

# Company info (shown in API docs and reports)
COMPANY_NAME=บริษัท ของคุณ จำกัด
COMPANY_TAX_ID=0000000000000          # 13 digits
VAT_RATE=7.0

# ── Frontend / Nginx ──────────────────────────────────────────────────────────
# Internal domain or public domain (without https://)
DOMAIN=accounting.internal

# Ports mapped on the host
HTTP_PORT=80
HTTPS_PORT=443

# ── Backup ────────────────────────────────────────────────────────────────────
# Number of daily backup files to retain
BACKUP_KEEP_DAYS=30
