# ══════════════════════════════════════════════════════════════════════════════
# Thai SME Accounting System — Environment Variables
# Copy to .env and fill in real values before running docker compose up
# NEVER commit .env to version control
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
APP_ENV=local
POSTGRES_DB=accounting_db
POSTGRES_USER=postgres
# Required — must not be left blank
POSTGRES_PASSWORD=change_me_strong_password_here
# Docker service name used when DATABASE_URL is not set.
DATABASE_HOST=db
# Optional full connection string. Leave blank locally to build it from the
# POSTGRES_* values above. Set this secret directly in production.
DATABASE_URL=
STATEMENT_DATABASE_URL=
# Production may use a privileged migrator role here while DATABASE_URL uses a
# restricted application role. Locally it defaults to DATABASE_URL.
MIGRATION_DATABASE_URL=

# Local path for persistent data (created automatically by Makefile)
DATA_DIR=./data

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_char_hex_secret_key_do_not_use_this_value

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480       # 8 hours

# Company info (shown in API docs and reports)
COMPANY_NAME=บริษัท ของคุณ จำกัด
COMPANY_TAX_ID=0000000000000          # 13 digits
VAT_RATE=7.0
# Local debugging: include request_id/error details in failed API responses.
# Set to false on the production server.
DEBUG=true

# ── crm-kawin (Order lookup for tax invoices) ────────────────────────────────
# Leave blank for local mock data. Production must use an internal HTTPS URL.
CRM_KAWIN_BASE_URL=http://dev.crm-kawin.test
CRM_KAWIN_ORDERS_PATH=/api/accounting/get_list_order.php
CRM_KAWIN_API_KEY=
CRM_KAWIN_TIMEOUT_SECONDS=15

# ── hr-kawin (SSO login via the "ระบบบัญชี" button in HR) ────────────────────
# Leave blank to hard-fail SSO login locally. Production must use an internal
# HTTPS URL and a real HR_KAWIN_BASE_URL secret.
HR_KAWIN_BASE_URL=http://dev.hr-kawin.test
HR_KAWIN_ME_PATH=/api/employees/me
HR_KAWIN_TIMEOUT_SECONDS=10

# ── Tax invoice Excel template PDF export ────────────────────────────────────
# Optional. Leave blank when soffice/libreoffice is available in PATH.
TAX_INVOICE_SOFFICE_PATH=
TAX_INVOICE_PDF_TIMEOUT_SECONDS=60

# ── Dompdf (legacy tax invoice PDF renderer) ─────────────────────────────────
# Kept only for compatibility with older deployments. Do not expose publicly.
DOMPDF_RENDERER_URL=http://tax_invoice_renderer:8090
DOMPDF_TIMEOUT_SECONDS=30

# ── Frontend / Nginx ──────────────────────────────────────────────────────────
# Internal domain or public domain (without https://)
DOMAIN=accounting.internal

# Ports mapped on the host
HTTP_PORT=80
HTTPS_PORT=443

# ── Backup ────────────────────────────────────────────────────────────────────
# Number of daily backup files to retain
BACKUP_KEEP_DAYS=30

# ── Claude AI (Statement OCR / Image batch) ───────────────────────────────────
# Required for uploading screenshot images via /statement/upload/images
ANTHROPIC_API_KEY=sk-ant-...

# ── Ollama (local receipt/tax-invoice OCR — free, self-hosted) ──────────────
# Ollama must run natively on the HOST (brew install ollama; ollama serve),
# not inside a container — Docker Desktop can't pass the Mac's GPU into a
# container. host.docker.internal lets the backend container reach it.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
