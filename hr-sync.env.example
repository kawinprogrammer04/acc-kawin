# Copy to hr-sync.env on the ACC production server. Never commit the real file.
# The one-time root installer safely merges these values into the production
# .env. The HR account must have SELECT permission only.
HR_SYNC_DB_HOST=replace_with_hr_mysql_host
HR_SYNC_DB_PORT=3306
HR_SYNC_DB_NAME=kawin_hr
HR_SYNC_DB_USER=replace_with_read_only_user
HR_SYNC_DB_PASSWORD=replace_with_read_only_password

# Every run compares the complete current snapshot from this date onward.
HR_SYNC_FROM_DATE=2026-01-01
HR_SYNC_BACKUP_KEEP=10
