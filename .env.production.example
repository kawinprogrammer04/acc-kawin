# Production secrets must be supplied on the server or by a secret manager.
# Never commit a completed copy of this file.
APP_ENV=production
DATABASE_URL=postgresql+asyncpg://<APP_USER>:<APP_PASSWORD>@<PROD_DB_HOST>:5432/acc_kawin_prod
MIGRATION_DATABASE_URL=postgresql+asyncpg://<MIGRATOR_USER>:<MIGRATOR_PASSWORD>@<PROD_DB_HOST>:5432/acc_kawin_prod
DATABASE_HOST=<PROD_DB_HOST>
POSTGRES_DB=acc_kawin_prod
POSTGRES_USER=<PROD_USER>
POSTGRES_PASSWORD=<PROD_PASSWORD>
SECRET_KEY=<PRODUCTION_64_CHAR_HEX_SECRET>
DEBUG=false

# crm-kawin service (server-side only; never expose the key to Vite/frontend)
CRM_KAWIN_BASE_URL=https://crm.kawinbrothers.com
CRM_KAWIN_ORDERS_PATH=/api/accounting/get_list_order.php
CRM_KAWIN_API_KEY=<PROD_CRM_SERVICE_TOKEN>
CRM_KAWIN_TIMEOUT_SECONDS=15
HR_KAWIN_BASE_URL=https://hr.kawinbrothers.com
HR_KAWIN_ME_PATH=/api/employees/me
HR_KAWIN_TIMEOUT_SECONDS=10
ACC_PUBLIC_BASE_URL=https://acc.kawinbrothers.com
TAX_INVOICE_SOFFICE_PATH=
TAX_INVOICE_PDF_TIMEOUT_SECONDS=60
DOMAIN=acc.kawinbrothers.com
HTTP_PORT=8080
HTTPS_PORT=8443
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKUP_KEEP_DAYS=30
