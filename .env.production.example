# ══════════════════════════════════════════════════════════════════════════════
# Finn Accounting — Plesk production environment
# Copy to .env on the server (same directory as docker-compose.plesk.yml):
#   cp .env.production.example .env
# NEVER commit the real .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

APP_ENV=production
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# Docker service name — leave as "db" unless docker-compose.plesk.yml is changed.
DATABASE_HOST=db
POSTGRES_DB=accounting_db
POSTGRES_USER=accounting_app
# Required — generate a strong password, e.g. `openssl rand -base64 24`
POSTGRES_PASSWORD=change_me_strong_password_here
# Optional full connection strings. Leave blank to build them from the
# POSTGRES_* values above (same role for both app + migrations). Set these
# instead if production uses a restricted application role plus a separate
# schema-owner/migrator role.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Used only by the Credit Statement Matcher service. Leave blank to build it
# from the POSTGRES_* values above.
STATEMENT_DATABASE_URL=

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_char_hex_secret_key_do_not_use_this_value

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

COMPANY_NAME=บริษัท ของคุณ จำกัด
COMPANY_TAX_ID=0000000000000
VAT_RATE=7.0

# ── crm-kawin (Order lookup for tax invoices) ────────────────────────────────
# Server-side only; never expose the key to Vite/frontend.
CRM_KAWIN_BASE_URL=https://crm.kawinbrothers.com
CRM_KAWIN_ORDERS_PATH=/api/accounting/get_list_order.php
CRM_KAWIN_API_KEY=<PROD_CRM_SERVICE_TOKEN>
CRM_KAWIN_TIMEOUT_SECONDS=15

# ── hr-kawin (SSO identity verification) ────────────────────────────────────
# Server-side only. HR must expose an endpoint that accepts the HR token as a
# Bearer token and returns {"employee": {"employee_id": "...", ...}}.
HR_KAWIN_BASE_URL=https://hr.kawinbrothers.com
HR_KAWIN_ME_PATH=/api/employees/me
HR_KAWIN_TIMEOUT_SECONDS=10
ACC_PUBLIC_BASE_URL=https://acc.kawinbrothers.com

# ── Tax invoice Excel template PDF export ────────────────────────────────────
# Optional. Leave blank when soffice/libreoffice is available in PATH (it is,
# inside the backend image).
TAX_INVOICE_SOFFICE_PATH=
TAX_INVOICE_PDF_TIMEOUT_SECONDS=60

# ── Dompdf (legacy tax invoice PDF renderer) ─────────────────────────────────
DOMPDF_RENDERER_URL=http://tax_invoice_renderer:8090
DOMPDF_TIMEOUT_SECONDS=30

# ── Claude AI (Statement OCR / Image batch) ───────────────────────────────────
# Required for uploading screenshot images via /statement/upload/images
ANTHROPIC_API_KEY=

# ── Ollama (local receipt/tax-invoice OCR — free, self-hosted) ──────────────
# Must run natively on the server (not inside a container). Leave the default
# if Ollama is not installed on this server — features that need it will just
# be unavailable, nothing else breaks.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# ── Frontend / Nginx ──────────────────────────────────────────────────────────
# Public domain — must match the Plesk subdomain
DOMAIN=acc.kawinbrothers.com

# Localhost-only port the container listens on. Plesk's reverse proxy
# (Apache & nginx Settings → Additional directives) must point here.
APP_PORT=18080

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_KEEP_DAYS=30
