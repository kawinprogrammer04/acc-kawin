# Local Docker environment. Copy to .env and replace every placeholder.
APP_ENV=local
DATABASE_HOST=db
DATABASE_URL=
MIGRATION_DATABASE_URL=
POSTGRES_DB=accounting_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<LOCAL_DATABASE_PASSWORD>
SECRET_KEY=<LOCAL_64_CHAR_HEX_SECRET>
DEBUG=true

# Blank = use clearly-labelled local mock order data
CRM_KAWIN_BASE_URL=http://dev.crm-kawin.test
CRM_KAWIN_ORDERS_PATH=/api/accounting/get_list_order.php
CRM_KAWIN_API_KEY=<LOCAL_ACCOUNTING_API_TOKEN>
TAX_INVOICE_SOFFICE_PATH=
TAX_INVOICE_PDF_TIMEOUT_SECONDS=60
DOMAIN=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKUP_KEEP_DAYS=30
